# Скопируйте в .env и заполните. Сам .env в git не попадает (.gitignore).

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую
ADMINS=
# Кто одобряет выплаты (+ необязательный список MONEY_ADMINS через запятую)
MONEY_ADMIN=
MONEY_ADMINS=

# ID группы для реферальных ссылок (вида -100XXXXXXXXXX)
GROUP_ID=
# Необязательно: группа для логов
LOG_GROUP_ID=

# PostgreSQL. В Docker при базе на этом же сервере: DB_HOST=host.docker.internal
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=

# Ключ шифрования реквизитов (обязателен). Создать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYOUT_ENCRYPTION_KEY=
# Только осознанно: работать без шифрования
# ALLOW_PLAINTEXT_PAYOUTS=1

# Необязательно: путь к url.yml (в docker-compose задаётся сам)
# URL_YML_PATH=/app/config/url.yml
