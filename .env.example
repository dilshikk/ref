# Скопируйте в .env и заполните. Сам .env в git не попадает (.gitignore).
# Здесь только то, без чего бот не запустится. Всё остальное — группа, денежные
# админы, тарифы, лимиты, тексты и каналы — настраивается в админ-панели бота
# и хранится в базе (таблица bot_settings).

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую
ADMINS=

# PostgreSQL. В Docker при базе на этом же сервере: DB_HOST=host.docker.internal
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=

# Ключ шифрования реквизитов (обязателен). Хранится здесь, а не в базе:
# ключ рядом с зашифрованными картами не защищает их при утечке дампа (#116). Создать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYOUT_ENCRYPTION_KEY=
# Только осознанно: работать без шифрования
# ALLOW_PLAINTEXT_PAYOUTS=1
