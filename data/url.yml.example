# Пример настроек. Скопируйте в config/url.yml (Docker) или data/url.yml и заполните.
# Реальные ID и ссылки сюда НЕ коммитить (#42).
channels:
- '@your_channel'
invited_credit: 500
# Публичная ссылка на чат/канал подтверждений выплат, например https://t.me/your_payments
payment_channel: ''
subcr_channel: https://t.me/your_channel
# Устарело: участники считаются по GROUP_ID из .env. Оставьте пустым или равным GROUP_ID
subcr_chat_id: ''
group_member_count: 5
min_balance: 50000
max_withdraw: 100000
vote_credit: 500
url: ''
support: '@your_support'
antispam_referral_limit: 20
antispam_referral_daily_limit: 100
referral_hold_hours: 72
add_min_hours: 24
add_min_score: 2
