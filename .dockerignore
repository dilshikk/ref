# Секреты и настройки НЕ попадают в образ: они подключаются при запуске
# (.env — через env_file в docker-compose.yml)
.env
.env.*
!.env.example
# Старые файлы настроек со старых серверов (реальные ID и ссылки) — не коммитить
# и не класть в образ. Нужны только для разового переноса в базу.
data/url.yml
config/

# Git и служебное
.git
.gitignore
.dockerignore
Dockerfile
docker-compose.yml

# Python
__pycache__/
*.py[cod]
*.so
venv/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Логи, локальные базы, IDE, ОС
logs/
*.log
main.db
.vscode/
.idea/
.DS_Store
Thumbs.db
